############################
# Étape deps/build
############################
FROM node:24-slim AS builder
WORKDIR /app

# Copie manifeste + lock (npm ci = reproductible)
COPY ./app/package*.json ./

# Install deps avec secret monté (jamais dans une layer, jamais dans l'historique)
RUN --mount=type=secret,id=github_token \
    set -eux; \
    if [ -f /run/secrets/github_token ]; then \
        TOKEN="$(cat /run/secrets/github_token)"; \
        { \
            echo "registry=https://registry.npmjs.org/"; \
            echo "@hugo38rodrigues:registry=https://npm.pkg.github.com/"; \
            echo "//npm.pkg.github.com/:_authToken=${TOKEN}"; \
        } > /root/.npmrc; \
    fi; \
    npm ci --omit=dev --no-audit --no-fund; \
    rm -f /root/.npmrc; \
    npm cache clean --force

# Copie le reste du code APRÈS install pour profiter du cache des dépendances
COPY ./app .


############################
# Étape runtime légère
############################
FROM node:24-slim AS runner

ENV NODE_ENV=production \
    NODE_OPTIONS="--enable-source-maps" \
    TZ=UTC

WORKDIR /app

# dumb-init pour gérer SIGTERM/SIGINT proprement (PID 1)
RUN apt-get update \
 && apt-get install -y --no-install-recommends dumb-init \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Création de l'utilisateur non-root AVANT le COPY, pour copier directement avec --chown
RUN groupadd --system --gid 1001 nodejs \
 && useradd  --system --uid 1001 --gid nodejs --no-create-home nodejs

# Copie depuis le builder avec ownership correct dès le départ (évite un chown récursif coûteux)
COPY --from=builder --chown=nodejs:nodejs /app ./

USER nodejs

ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "load-data"]